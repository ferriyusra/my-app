# Copy to `.env` and fill in. Everything here is optional — the app runs
# without any of it, and each value falls back to a working default in code.

# ── Music search (src/app/api/music/search/route.ts) ──
# The catalogue the Media Player searches, and how long Next may serve a
# repeated search from cache. Set MUSIC_CACHE_SECONDS=0 to disable caching.
MUSIC_SEARCH_ENDPOINT=https://itunes.apple.com/search
MUSIC_CACHE_SECONDS=3600

# ── Contact form (src/app/api/contact/route.ts) ──
# Without RESEND_API_KEY the form reports `delivered: false` and the Mail
# window falls back to opening a pre-filled mailto: draft.
# RESEND_API_KEY=
# CONTACT_FROM=portfolio@example.com
# CONTACT_TO=you@example.com
